# Required. Sent as the x-api-key header on every request except /health.
API_KEY=change-me-to-a-long-random-string

# Where the database and rendered PNGs live. Mount a persistent volume here.
DATA_DIR=/data

PORT=3000
HOST=0.0.0.0

# Unposted renders older than this are deleted. Posted ones go on the next cleanup.
RENDER_RETENTION_DAYS=14
RENDERS_PER_MIN=30
TEMPLATE_VERSIONS_KEEP=50

# Claude copywriting. Use a Console API key here, never export it in your own shell.
# Without it the app runs and only the copywriting endpoints are switched off.
ANTHROPIC_API_KEY=
# Hard stop for Claude spend each calendar month, and the exchange rate used to convert
# the API's US dollar prices. Update the rate now and then.
CLAUDE_MONTHLY_CAP_GBP=20
GBP_PER_USD=0.79
