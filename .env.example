# Required. Sent as the x-api-key header on every request except /health.
API_KEY=change-me-to-a-long-random-string

# Where the database and rendered PNGs live. Mount a persistent volume here.
DATA_DIR=/data

PORT=3000
HOST=0.0.0.0

# Unposted renders older than this are deleted. Posted ones go 3 days after they go out.
RENDER_RETENTION_DAYS=14
RENDERS_PER_MIN=30
TEMPLATE_VERSIONS_KEEP=50

# Claude copywriting. Use a Console API key here, never export it in your own shell.
# Without it the app runs and only the copywriting endpoints are switched off.
ANTHROPIC_API_KEY=
# Hard stop for Claude spend each calendar month, and the exchange rate used to convert
# the API's US dollar prices. Update the rate now and then.
CLAUDE_MONTHLY_CAP_GBP=20
GBP_PER_USD=0.79

# Buffer posting. Without the key the app runs and only the Buffer endpoints are off.
BUFFER_API_KEY=
# The address this app is reachable at from the internet, e.g. https://social.redcherryit.com
# Buffer fetches post images from PUBLIC_URL/public/renders/<id>.png, so it must be public.
PUBLIC_URL=
# Leave false: every post waits for approval. true sends posts to Buffer as soon as they are added.
AUTO_POST=false

# Articles. With SITE_REPO set, Publish commits the page, its card on the category page and its
# sitemap entry to the website's GitHub repo, and 20i deploys from there.
# Make SITE_GITHUB_TOKEN a fine grained token with Contents read and write on that one repo only.
SITE_REPO=Hambowsky/red-cherry-it-website
SITE_BRANCH=main
SITE_GITHUB_TOKEN=
# Without SITE_REPO, published pages are saved here instead, to upload by hand.
PUBLISH_DIR=/data/site
# Used for article links, canonical URLs and the sitemap.
SITE_URL=https://redcherryit.com
